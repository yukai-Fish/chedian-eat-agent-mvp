page {
  min-height: 100%;
  background: linear-gradient(180deg, #fcf7ed 0%, #f4ead5 100%);
  color: #1c2638;
  font-family: "PingFang SC", "Noto Sans SC", sans-serif;
}

.glass-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(198, 159, 85, 0.32);
  box-shadow: 0 20rpx 60rpx rgba(139, 96, 22, 0.08);
  border-radius: 28rpx;
  backdrop-filter: blur(10rpx);
}

.gold-btn {
  background: linear-gradient(120deg, #7c6036 0%, #c49a58 46%, #3d57cf 100%);
  color: #fff;
  border: none;
}

.ghost-btn {
  background: rgba(255, 255, 255, 0.76);
  color: #7b5b2a;
  border: 1rpx solid rgba(195, 156, 83, 0.38);
}
