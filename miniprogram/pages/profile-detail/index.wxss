.page {
  padding: 20rpx 22rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.notice-card,
.section-card {
  border-radius: 24rpx;
  border: 1rpx solid rgba(198, 159, 85, 0.28);
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 14rpx 34rpx rgba(143, 98, 30, 0.08);
}

.notice-card {
  padding: 14rpx 16rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #7e5a26;
  line-height: 1.4;
}

.section-card {
  padding: 16rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 999rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 148, 78, 0.34);
  background: linear-gradient(145deg, rgba(240, 228, 200, 0.95), rgba(216, 194, 150, 0.95));
}

.avatar-fallback-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #6f5328;
}

.avatar-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #22324f;
}

.block-sub {
  font-size: 22rpx;
  color: #667891;
}

.block-subtime {
  font-size: 20rpx;
  color: #8a97aa;
}

.light-btn {
  margin: 0;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #7f6334;
  border: 1rpx solid rgba(185, 148, 78, 0.34);
  background: rgba(255, 255, 255, 0.95);
}

.light-btn::after {
  border: none;
}

.form-row {
  margin-top: 16rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #5a6c87;
}

.form-input {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(170, 183, 208, 0.38);
  background: rgba(247, 250, 255, 0.94);
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #2d405d;
}

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5a6c87;
}

.section-sub {
  font-size: 21rpx;
  color: #8b6d3c;
}

.taste-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.taste-tag {
  height: 64rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(171, 183, 206, 0.36);
  background: rgba(241, 245, 252, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #3e5474;
}

.taste-tag-active {
  color: #7a5a2b;
  border: 1rpx solid rgba(193, 154, 82, 0.34);
  background: rgba(248, 236, 210, 0.86);
}

.dislike-input {
  width: 100%;
  margin-top: 10rpx;
  min-height: 110rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(170, 183, 208, 0.38);
  background: rgba(247, 250, 255, 0.94);
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #2d405d;
  line-height: 1.4;
}

.picker-value {
  margin-top: 10rpx;
  height: 70rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(170, 183, 208, 0.38);
  background: rgba(247, 250, 255, 0.94);
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #2d405d;
}

.picker-arrow {
  color: #8a6a36;
  font-size: 24rpx;
  line-height: 1;
}

.save-btn {
  margin: 0;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  border: none;
  border-radius: 18rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  background: linear-gradient(120deg, #7c6036 0%, #c49a58 46%, #3d57cf 100%);
  box-shadow: 0 14rpx 28rpx rgba(89, 74, 137, 0.2);
}

.save-btn::after {
  border: none;
}
