<view class="page">
  <view class="hero glass-card">
    <view class="hero-deco"></view>
    <view class="hero-head">
      <view>
        <text class="title">我的</text>
      </view>
      <button
        class="{{isAuthenticated ? 'ghost-btn' : 'gold-btn'}} login-btn"
        loading="{{loginLoading}}"
        disabled="{{isAuthenticated}}"
        bindtap="onWechatLogin"
      >
        {{isAuthenticated ? '微信已登录' : '微信登录'}}
      </button>
    </view>
    <view class="identity-panel">
      <text class="identity-label">{{identityLabel}}</text>
      <text class="identity-sub">匿名标识：{{anonymousIdShort || "未生成"}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item glass-card">
      <text class="stat-value">{{favoritesCount}}</text>
      <text class="stat-label">我的收藏</text>
      <text class="stat-tip">常用店铺会持续沉淀到个人偏好</text>
    </view>
    <view class="stat-item glass-card">
      <text class="stat-value">{{queryHistoryCount}}</text>
      <text class="stat-label">最近查询</text>
      <text class="stat-tip">保留近期需求，方便一键复用</text>
    </view>
    <view class="stat-item glass-card">
      <text class="stat-value">{{locationEnabled ? "已开" : "未开"}}</text>
      <text class="stat-label">定位权限</text>
      <text class="stat-tip">{{locationEnabled ? "附近优先可按实时位置推荐" : "建议开启定位，获取更近店铺"}}</text>
    </view>
  </view>

  <view class="actions glass-card">
    <text class="section-title">常用操作</text>

    <view class="action-item" bindtap="onOpenLocationSetting">
      <view class="action-main-wrap">
        <text class="action-main">定位权限设置</text>
        <text class="action-sub">{{locationEnabled ? "已授权定位，可继续优化附近推荐准确度" : "去系统设置开启定位权限，提升附近优先效果"}}</text>
      </view>
      <text class="action-arrow">></text>
    </view>

    <view class="action-item" bindtap="onGoAds">
      <view class="action-main-wrap">
        <text class="action-main">查看商家推荐页</text>
        <text class="action-sub">浏览商家精选内容与活动展示位</text>
      </view>
      <text class="action-arrow">></text>
    </view>

    <view class="action-item action-primary" bindtap="onGoInquiry">
      <view class="action-main-wrap">
        <text class="action-main action-main-primary">返回问询页</text>
        <text class="action-sub action-sub-primary">继续输入需求，获取新的推荐结果</text>
      </view>
      <text class="action-arrow action-arrow-primary">></text>
    </view>
  </view>
</view>
