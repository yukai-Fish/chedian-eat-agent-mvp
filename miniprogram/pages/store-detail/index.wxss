.page {
  min-height: 100vh;
  padding: 24rpx;
}

.state-card {
  border-radius: 22rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(193, 154, 82, 0.28);
  color: #3b4a63;
}

.error {
  color: #be4b4b;
  border-color: rgba(190, 75, 75, 0.3);
}

.detail-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.gallery-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(193, 154, 82, 0.25);
  background: rgba(255, 255, 255, 0.95);
}

.gallery-swiper {
  width: 100%;
  height: 360rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-empty {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #76839b;
  font-size: 28rpx;
}

.gallery-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(19, 34, 56, 0.54);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.info-card,
.tag-card,
.review-card {
  border-radius: 22rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(193, 154, 82, 0.25);
}

.title-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
}

.name {
  flex: 1;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #14233a;
}

.price-pill {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #7c5c2c;
  border-radius: 999rpx;
  background: rgba(205, 165, 88, 0.2);
  border: 1rpx solid rgba(193, 154, 82, 0.32);
  padding: 10rpx 18rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667690;
}

.status-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.status-badge {
  font-size: 22rpx;
  color: #fff;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.status-open {
  background: linear-gradient(130deg, #2f9e63, #22bb6f);
}

.status-closing {
  background: linear-gradient(130deg, #d9933a, #ebb153);
}

.status-closed,
.status-unknown {
  background: linear-gradient(130deg, #6f7a8f, #8a95ab);
}

.status-detail {
  font-size: 22rpx;
  color: #54637b;
}

.line-item {
  margin-top: 14rpx;
}

.line-label {
  display: block;
  font-size: 22rpx;
  color: #7b879b;
}

.line-value {
  margin-top: 4rpx;
  display: block;
  font-size: 27rpx;
  color: #263752;
  line-height: 1.45;
}

.address {
  word-break: break-all;
}

.line-phone-wrap {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.call-btn {
  margin: 0;
  width: 118rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  text-align: center;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #bc8e44, #4a63db);
}

.tag-group + .tag-group {
  margin-top: 14rpx;
}

.tag-title {
  font-size: 24rpx;
  color: #455875;
  font-weight: 600;
}

.tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: #78592b;
  border: 1rpx solid rgba(193, 154, 82, 0.34);
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  background: rgba(255, 251, 241, 0.84);
}

.review-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.review-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2d44;
}

.review-meta {
  font-size: 22rpx;
  color: #6c7890;
}

.empty-review {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #74839c;
}

.review-item {
  margin-top: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(193, 154, 82, 0.22);
  background: rgba(255, 251, 240, 0.75);
  padding: 14rpx 16rpx;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.review-rating {
  font-size: 22rpx;
  color: #7f5d2e;
}

.review-time {
  font-size: 20rpx;
  color: #8693a9;
}

.review-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #4a5a74;
  line-height: 1.55;
}

.review-extra {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #65748d;
}
