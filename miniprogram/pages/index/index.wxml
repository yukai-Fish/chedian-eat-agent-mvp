<view class="page">
  <view class="hero glass-card">
    <view class="hero-top">
      <view>
        <view class="title">成电吃什么</view>
        <view class="subtitle">校园美食推荐 · 小程序版</view>
      </view>
      <view class="identity">{{identityLabel}}</view>
    </view>
    <view class="summary">{{summary || "输入你的需求，获取校园美食推荐。"}}</view>
  </view>

  <view class="composer glass-card">
    <textarea
      class="query-input"
      placeholder="输入你的需求，例如：清水河附近预算30想吃辣"
      value="{{query}}"
      bindinput="onInputQuery"
      maxlength="300"
      auto-height="true"
    />
    <view class="quick-wrap">
      <block wx:for="{{quickPrompts}}" wx:key="*this">
        <view class="quick-item" bindtap="onTapQuickPrompt" data-prompt="{{item}}">{{item}}</view>
      </block>
    </view>
    <view class="action-row">
      <button class="ghost-btn feedback-btn" bindtap="openFeedback">✦ 反馈新店 / 用餐体验</button>
      <button class="gold-btn submit-btn" loading="{{loading}}" bindtap="onSubmitQuery">发送</button>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">正在生成推荐，通常需要 10-40 秒，请稍候…</view>
  </view>

  <view wx:if="{{error}}" class="error glass-card">{{error}}</view>

  <view class="result glass-card">
    <view class="result-head">
      <text class="result-title">推荐结果</text>
      <button wx:if="{{canSwitchBatch}}" class="ghost-btn batch-btn" bindtap="onSwitchBatch">换一批</button>
    </view>

    <view wx:if="{{visibleCards.length === 0}}" class="empty">
      <text>暂无结构化推荐结果。</text>
      <text wx:if="{{rawAnswer}}" class="raw-title">模型原始回答：</text>
      <text wx:if="{{rawAnswer}}" class="raw-text">{{rawAnswer}}</text>
    </view>

    <block wx:for="{{visibleCards}}" wx:key="name">
      <view class="card">
        <view class="card-head">
          <text class="card-name">{{item.name}}</text>
          <text wx:if="{{item.scoreLabel}}" class="score">{{item.scoreLabel}}</text>
        </view>

        <view wx:if="{{item.reason}}" class="field">
          <text class="label">推荐理由</text>
          <text class="value">{{item.reason}}</text>
        </view>
        <view wx:if="{{item.recommendDish}}" class="field">
          <text class="label">推荐菜</text>
          <text class="value">{{item.recommendDish}}</text>
        </view>
        <view wx:if="{{item.sceneFit}}" class="field">
          <text class="label">适合场景</text>
          <text class="value">{{item.sceneFit}}</text>
        </view>
        <view wx:if="{{item.warning}}" class="field">
          <text class="label">可能不足</text>
          <text class="value">{{item.warning}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{feedbackOpen}}" class="mask" bindtap="onTapFeedbackMask">
    <view class="modal glass-card" bindtap="stopTap">
      <view class="modal-head">
        <text class="modal-title">美食反馈</text>
        <text class="close" bindtap="closeFeedback">✕</text>
      </view>
      <view class="tab-row">
        <view class="tab {{feedbackTab==='new_store'?'tab-active':''}}" data-tab="new_store" bindtap="onSwitchFeedbackTab">推荐新店</view>
        <view class="tab {{feedbackTab==='dining_feedback'?'tab-active':''}}" data-tab="dining_feedback" bindtap="onSwitchFeedbackTab">吃后反馈</view>
      </view>

      <view class="form-row">
        <text class="form-label">店名</text>
        <input class="form-input" value="{{feedbackForm.storeName}}" data-field="storeName" bindinput="onFeedbackFieldInput" placeholder="例如：北方面馆" />
      </view>

      <view class="form-row">
        <text class="form-label">推荐菜</text>
        <input class="form-input" value="{{feedbackForm.recommendDish}}" data-field="recommendDish" bindinput="onFeedbackFieldInput" placeholder="选填" />
      </view>

      <view class="form-row">
        <text class="form-label">推荐理由</text>
        <input class="form-input" value="{{feedbackForm.recommendReason}}" data-field="recommendReason" bindinput="onFeedbackFieldInput" placeholder="选填" />
      </view>

      <view wx:if="{{feedbackTab==='dining_feedback'}}" class="form-row">
        <text class="form-label">评分</text>
        <slider min="1" max="5" step="1" show-value value="{{feedbackForm.rating}}" bindchange="onFeedbackRatingChange" />
      </view>

      <view class="form-row">
        <text class="form-label">{{feedbackTab==='dining_feedback' ? '用餐评价' : '补充说明'}}</text>
        <textarea class="form-textarea" value="{{feedbackForm.comment}}" data-field="comment" bindinput="onFeedbackFieldInput" maxlength="300" />
      </view>

      <button class="gold-btn submit-feedback-btn" loading="{{feedbackLoading}}" bindtap="onSubmitFeedback">提交反馈</button>
    </view>
  </view>
</view>
